# Universal AI GIS Studio — Environment Configuration
# Copy this file to .env and customize for your environment
# Never commit .env to version control!

# =============================================================================
# QGIS BRIDGE CONFIGURATION
# =============================================================================

# Bridge server URL (where the QGIS Bridge HTTP server runs)
# Default: http://127.0.0.1:8765
UAGIS_BRIDGE_URL=http://127.0.0.1:8765

# Bridge authentication token (optional but recommended for production)
# If set, all Bridge requests must include: Authorization: Bearer <token>
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
UAGIS_BRIDGE_AUTH_TOKEN=

# Bridge server host/port (for the bridge server itself)
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765

# WebSocket port for screen streaming
BRIDGE_WS_PORT=8767

# =============================================================================
# MCP SERVER CONFIGURATION
# =============================================================================

# MCP server transport: stdio | streamable-http
MCP_TRANSPORT=stdio

# Streamable HTTP port (if using streamable-http transport)
MCP_HTTP_PORT=8766

# MCP server auth token (for streamable-http)
MCP_AUTH_TOKEN=

# =============================================================================
# QGIS CONFIGURATION
# =============================================================================

# QGIS installation path (auto-detected if not set)
# Windows example: C:\Program Files\QGIS 4.2.3
# Linux example: /usr
# macOS example: /Applications/QGIS.app/Contents/MacOS
QGIS_PREFIX_PATH=

# QGIS Python path (for external scripts)
QGIS_PYTHON_PATH=

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# SQLite database path (relative to project root or absolute)
DATABASE_PATH=data/uagis.db

# Database connection pool size
DB_POOL_SIZE=5

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Secret key for session signing (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=

# JWT settings (if using JWT auth)
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# =============================================================================
# RATE LIMITING
# =============================================================================

# Enable Redis for distributed rate limiting (optional)
REDIS_URL=redis://localhost:6379/0

# Default rate limits (requests per second)
DEFAULT_RATE_LIMIT=10
DEFAULT_RATE_CAPACITY=100

# =============================================================================
# RESOURCE QUOTAS
# =============================================================================

# Default job resource limits
DEFAULT_MAX_MEMORY_MB=1024
DEFAULT_MAX_CPU_SECONDS=3600
DEFAULT_MAX_DISK_MB=512
DEFAULT_MAX_DURATION_SECONDS=3600

# System memory threshold for pausing (0.0-1.0)
SYSTEM_MEMORY_THRESHOLD=0.9

# =============================================================================
# LOGGING
# =============================================================================

LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/uagis.log

# =============================================================================
# EXTERNAL AI PROVIDERS (optional)
# =============================================================================

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# Google Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_DEFAULT_MODEL=gemini-1.5-flash

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini

# Custom/OpenAI-compatible (Ollama, LM Studio, vLLM)
CUSTOM_API_KEY=
CUSTOM_BASE_URL=http://localhost:11434/v1
CUSTOM_DEFAULT_MODEL=llama3.1

# =============================================================================
# PLUGIN SETTINGS
# =============================================================================

# Auto-start bridge on QGIS startup
PLUGIN_AUTO_START_BRIDGE=true

# Bridge port (must match BRIDGE_PORT)
PLUGIN_BRIDGE_PORT=8765

# Show debug info in plugin UI
PLUGIN_DEBUG=false